# The app reads real environment variables. It does not load this file itself.
# Use it with:  set -a; . ./.env; set +a; make run

# Required for real stories. Without it the app plays an offline mock story.
OPENROUTER_API_KEY=

# Optional
# MODELS=deepseek/deepseek-v4.1-flash-1017
# PROVIDER=stepfun
# REASONING=low
# JUDGE=on
# ROOM_PASSPHRASE=
# MAX_GAMES_PER_HOUR=10
# PORT=8080
