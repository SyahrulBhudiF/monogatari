package main

import (
	"fmt"
	"strconv"
	"strings"
)

templ Index() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"/>
			<meta name="theme-color" content="#58cc02"/>
			<title>Monogatari</title>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@500;700;900&display=swap" rel="stylesheet"/>
			<link rel="stylesheet" href="/static/style.css"/>
			<script src="/static/pid.js"></script>
			<script type="module" src="/static/datastar.js"></script>
		</head>
		<body data-signals="{name:'',pass:'',pid:window.PID,guide:false,menu:false}" data-init="@get('/stream',{openWhenHidden:true})">
			<main id="app"></main>
			@Guide()
		</body>
	</html>
}

templ Guide() {
	<div class="guide" style="display:none" data-show="$guide" role="dialog" aria-modal="true" aria-label="How to play">
		<div class="guide-card">
			<div class="guide-head">
				<h2>How to play</h2>
				<button class="x" aria-label="Close" data-on:click="$guide=false">✕</button>
			</div>
			<div class="guide-body">
				@GuideItem("🧍", "Solo mode", "Alone in the lobby, press Play solo, then Ready. You get a short narrated text instead of a conversation. You read it sentence by sentence: order the words, read aloud, answer the quiz. Everything else works the same.")
				@GuideItem("☰", "Menu", "The ☰ button at the top opens the menu: how to play, furigana, leaving the game, and playing again. The host (the crown) can also end the game for everyone. If you leave during a game, your turns are played for you and you keep watching.")
				@GuideItem("🎙️", "Play on a voice call", "Everyone joins the same voice call, for example on Discord. The app shows the game. You talk to each other.")
				@GuideItem("📖", "One story, many levels", "An AI writes a short story for your group. Each player is one character. Your lines match your own level, so an N5 and an N2 player can play together.")
				@GuideItem("🪜", "Your level", "Pick one of 15 steps, from Low N5 to High N1. Low means you just started that level. High means you are close to the next one. Pick honestly: the AI uses it to choose words and grammar.")
				@GuideItem("🗳️", "Ready vote", "The game starts when 2 or more players are connected and everyone pressed Ready. If someone changes their level, all votes reset. The first player is the host and can remove someone who is away.")
				@GuideItem("🎯", "Briefing", "Before the story you see your goal, one thing to teach the others, key words, and a short reading at your level. Read it, then press Start.")
				@GuideItem("🔤", "Your turn: order the words", "Turns go in strict rotation. You see the English meaning and a set of word blocks. Tap the blocks in the right order. Tap a placed block to take it back. Press Check. Red blocks show what to fix. You can try as many times as you need.")
				@GuideItem("🤝", "Help each other", "Everyone sees every move live. Spectators cannot tap, but they can give hints by voice. This is the point of the game.")
				@GuideItem("🎤", "Read it aloud", "When the order is right, the sentence appears with its reading. Read it out loud on the call, then press Done.")
				@GuideItem("❓", "Quiz", "You get one multiple-choice question about the sentence, written for your level. After you answer, everyone sees the correct answer and a short explanation. A wrong answer is fine: it teaches.")
				@GuideItem("⭐", "Stars", "Each correct quiz answer gives you one star. Turns that the game plays for you give none.")
				@GuideItem("💤", "If someone drops out", "If the active player leaves, the game plays the turn for them after 8 seconds and moves on. The host can also skip a turn.")
				@GuideItem("ふ", "Furigana", "Press ふ at the top to hide or show the small reading above kanji. Hide it when you want a harder game. Translations after a turn and in the wrap-up are hidden until you tap Show translation.")
				@GuideItem("🎉", "Wrap-up", "At the end you see the full story, everyone's stars, the lines that were missed, and every player's word list.")
			</div>
			<button class="btn green" data-on:click="$guide=false">Got it</button>
		</div>
	</div>
}

templ GuideItem(icon, title, text string) {
	<section class="gi">
		<span class="gi-ic">{ icon }</span>
		<div>
			<h3>{ title }</h3>
			<p>{ text }</p>
		</div>
	</section>
}

templ Shell(v V) {
	{{ nofg := v.R.hideFuri[v.Token] }}
	<main id="app" class={ "mood-" + v.mood(), templ.KV("nofg", nofg) }>
		<div class="shell">
			<header class="top">
				<button class="hbtn" aria-label="Menu" title="Menu" data-on:click="$menu=true">☰</button>
				<div class="logo"><span class="mark" lang="ja">物語</span> monogatari</div>
				<button class={ "hbtn", templ.KV("dim", nofg) } lang="ja" aria-label="Show or hide furigana" title="Show or hide furigana" data-on:click="@post('/furi')">ふ</button>
			</header>
			@Menu(v, nofg)
			{ children... }
		</div>
	</main>
}

templ Menu(v V, nofg bool) {
	{{ ph := v.R.Phase }}
	<div class="guide" style="display:none" data-show="$menu" role="dialog" aria-modal="true" aria-label="Menu" data-on:click="$menu=false">
		<div class="guide-card menu" data-on:click__stop="1">
			<div class="guide-head">
				<h2>Menu</h2>
				<button class="x" aria-label="Close" data-on:click="$menu=false">✕</button>
			</div>
			<div class="menu-list">
				<button class="menu-item" data-on:click="$menu=false;$guide=true"><span>❓</span>How to play</button>
				<button class="menu-item" data-on:click="@post('/furi')">
					<span lang="ja">ふ</span>
					if nofg {
						Show furigana
					} else {
						Hide furigana
					}
				</button>
				if ph == "finished" {
					<button class="menu-item" data-on:click="$menu=false;@post('/reset')"><span>🔁</span>Play again</button>
				}
				if v.Me != nil && ph == "lobby" {
					<button class="menu-item danger" data-on:click="$menu=false;@post('/leave')"><span>🚪</span>Leave lobby</button>
				}
				if v.Me != nil && (ph == "generating" || ph == "briefing" || ph == "playing") {
					<button class="menu-item danger" data-on:click="$menu=false;confirm('Leave the game? Your turns will be played for you.') && @post('/leave')"><span>🚪</span>Leave game</button>
				}
				if v.isHost() && (ph == "generating" || ph == "briefing" || ph == "playing") {
					<button class="menu-item danger" data-on:click="$menu=false;confirm('End the game for everyone?') && @post('/abort')"><span>⏹️</span>End game for everyone</button>
				}
			</div>
		</div>
	</div>
}

templ Root(v V) {
	@Shell(v) {
		if v.Me == nil {
			@Outsider(v)
		} else if v.R.Phase == "lobby" {
			@LobbyView(v)
		} else if v.R.Phase == "generating" {
			@GeneratingView(v)
		} else if v.R.Phase == "briefing" {
			@BriefingView(v)
		} else if v.R.Phase == "playing" {
			@PlayView(v)
		} else {
			@FinishedView(v)
		}
	}
}

templ Outsider(v V) {
	if v.R.Phase == "lobby" {
		@JoinView(v)
	} else if v.R.Phase == "playing" {
		<div class="watch" role="status">👀 You are watching this game</div>
		@PlayView(v)
	} else if v.R.Phase == "finished" {
		@FinishedView(v)
	} else {
		<div class="card pop center">
			<div class="big bob">📖</div>
			<h2>A story is being written</h2>
			<p class="muted">You can join the next game when this one ends.</p>
		</div>
	}
}

templ Badge(p *Player) {
	<span class={ "lv", "lv-" + p.Level }>{ badgeText(p) }</span>
}

templ Slider(cur int) {
	<div class="slider">
		<div class="lvl-label">{ lvLabel(cur) }</div>
		<div class="lvl-groups">
			for g, l := range levels {
				<div class="lvl-group">
					<div class="lvl-steps">
						for k := 0; k < 3; k++ {
							<button
								class={ "step-b", templ.KV("on", g*3+k <= cur), templ.KV("cur", g*3+k == cur) }
								aria-label={ positions[k] + " " + l }
								aria-pressed={ strconv.FormatBool(g*3+k == cur) }
								data-on:click={ fmt.Sprintf("@post('/level?lv=%d')", g*3+k) }
							></button>
						}
					</div>
					<span>{ l }</span>
				</div>
			}
		</div>
	</div>
}

templ Roster(v V, kick bool) {
	if len(v.R.Players) > 0 {
		<div class="roster">
			for _, p := range v.R.Players {
				<div class={ "person", templ.KV("off", !v.R.on(p)), templ.KV("ready", p.Ready) } id={ "p-" + p.ID }>
					<span class={ "dot", "lv-" + p.Level }>{ initial(p.Name) }</span>
					<b>{ p.Name }</b>
					@Badge(p)
					if v.R.host() == p {
						<span class="crown" title="Host">👑</span>
					}
					<span class="tick">✓</span>
					if kick && v.isHost() && p != v.Me {
						<button class="kick" aria-label={ "Remove " + p.Name } data-on:click={ "@post('/kick?id=" + p.ID + "')" }>✕</button>
					}
				</div>
			}
		</div>
	}
}

templ ReadyButton(v V, on, off string) {
	{{ rd, c := v.R.readyCount() }}
	if v.Me.Ready {
		<button class="btn ghost" data-on:click="@post('/ready')">{ fmt.Sprintf("%s · %d/%d", off, rd, c) }</button>
	} else {
		<button class="btn green" data-on:click="@post('/ready')">{ fmt.Sprintf("%s · %d/%d", on, rd, c) }</button>
	}
}

templ LogBox(v V) {
	if v.Me != nil {
		<div class="logbox" id="logbox">
			<button class="link" data-on:click="@post('/toggle?k=log')">
				if v.Me.Open["log"] {
					Hide log
				} else {
					Show log
				}
			</button>
			if v.Me.Open["log"] {
				<pre class="log">{ strings.Join(v.R.logLines(), "\n") }</pre>
			}
		</div>
	}
}

templ JoinView(v V) {
	<div class="card pop">
		<h1>Join the story</h1>
		<input class="input" data-bind:name placeholder="Your name" maxlength="16" autocomplete="off" aria-label="Your name" data-on:keydown.enter="$name && @post('/join')"/>
		if v.R.Pass != "" {
			<input class="input" type="password" data-bind:pass placeholder="Room passphrase" autocomplete="off" aria-label="Room passphrase" data-on:keydown.enter="$name && @post('/join')"/>
		}
		@Slider(v.R.prefLv(v.Token))
		<button class="btn green" data-on:click="$name && @post('/join')">Join</button>
		if msg := v.R.joinErr[v.Token]; msg != "" {
			<p class="err center" role="alert">{ msg }</p>
		}
		if v.R.Err != "" {
			<p class="err center" role="alert">{ v.R.Err }</p>
		}
		<button class="btn ghost" data-on:click="$guide=true">How to play</button>
	</div>
	@Roster(v, false)
}

templ LobbyView(v V) {
	<div class="card pop">
		<h1>Lobby</h1>
		@Roster(v, true)
		@Slider(lvIndex(v.Me.Level, v.Me.Pos))
		if len(v.R.Players) == 1 {
			if v.R.Solo {
				<button class="btn ghost" aria-pressed="true" data-on:click="@post('/solo?on=0')">Solo: on</button>
			} else {
				<button class="btn ghost" aria-pressed="false" data-on:click="@post('/solo?on=1')">Play solo</button>
			}
		}
		@ReadyButton(v, "Ready", "Not ready")
		if len(v.R.Players) < 2 && !v.R.Solo {
			<p class="muted center">Need 2 players, or play solo</p>
		}
		if v.R.Err != "" {
			<p class="err center" role="alert">{ v.R.Err }</p>
		}
		@LogBox(v)
		<button class="link" data-on:click="@post('/leave')">Leave</button>
	</div>
}

templ GeneratingView(v V) {
	<div class="card pop center">
		<div class="big bob">📖</div>
		<h2>Writing your story<span class="dots"></span></h2>
		@Roster(v, false)
		@LogBox(v)
	</div>
}

templ BriefingView(v V) {
	{{ br := v.R.Plan.Briefings[v.MI] }}
	{{ ch := v.R.Plan.Characters[v.MI] }}
	{{ step := v.Me.Step }}
	<div class="brief">
		<div class="steps">
			for i := 0; i < 3; i++ {
				<i class={ templ.KV("on", i <= step) }></i>
			}
		</div>
		if step == 0 {
			<section class="step">
				<div class="row hero">
					<div class="avatar bob">{ ch.Emoji }</div>
					<div>
						<h2 lang="ja">{ ch.Name }</h2>
						<div>@Badge(v.Me) <span class="muted">{ ch.Personality }</span></div>
					</div>
				</div>
				<div class="mission">
					<div class="mi goalc">
						<span class="ic">🎯</span>
						<div><b>Your goal</b><p>@Notation(br.Goal)</p></div>
					</div>
					<div class="mi teachc">
						<span class="ic">💡</span>
						<div>
							<b>
								if len(v.R.Players) == 1 {
									Remember
								} else {
									Teach the others
								}
							</b>
							<p>@Notation(br.Teach)</p>
						</div>
					</div>
				</div>
				if len(v.R.Players) > 1 {
					<h3>Your team</h3>
					<div class="team">
						for i, o := range v.R.Plan.Briefings {
							if i != v.MI {
								<div class="row tm">
									<div class="avatar sm">{ v.R.Plan.Characters[i].Emoji }</div>
									<div><b>{ v.R.Players[i].Name }</b> @Badge(v.R.Players[i])<p>@Notation(o.Goal)</p></div>
								</div>
							}
						}
					</div>
				}
			</section>
		} else if step == 1 {
			<section class="step">
				<h2>Words to know</h2>
				<div class="wordgrid">
					for _, wd := range br.Words {
						<div class="wc" lang="ja"><ruby>{ wd.JP }<rt>{ wd.Reading }</rt></ruby><span lang="en">{ wd.EN }</span></div>
					}
				</div>
			</section>
		} else {
			<section class="step">
				<h2 lang="ja">@Notation(v.R.Plan.Scenario.Title)</h2>
				<div class="story">
					for _, l := range readingLines(br.Reading) {
						<p class="jp sent" lang="ja">@NotationWrap(l)</p>
					}
				</div>
				<button class="link" data-on:click="@post('/toggle?k=en')">
					if v.Me.Open["en"] {
						Hide English
					} else {
						Show English
					}
				</button>
				if v.Me.Open["en"] {
					<p class="en">{ br.ReadingEN }</p>
				}
				@LogBox(v)
			</section>
		}
	</div>
	@Dock(v, step)
}

templ Dock(v V, step int) {
	{{ ready := v.R.linesReady() }}
	{{ n := len(v.R.Lines) }}
	<div class="dock">
		<div class="dock-in">
			if step == 2 && ready < n {
				<div class="muted center">{ fmt.Sprintf("Writing lines %d/%d", ready, n) }<span class="dots"></span></div>
			}
			<div class="dock-btns">
				if step > 0 {
					<button class="btn ghost back" data-on:click="@post('/brief?d=-1')">Back</button>
				}
				if step < 2 {
					<button class="btn green" data-on:click="@post('/brief?d=1')">Continue</button>
				} else {
					@ReadyButton(v, "Start", "Waiting")
				}
			</div>
			if step == 2 && v.isHost() {
				<button class="link" data-on:click="@post('/startnow')">Start without waiting</button>
			}
		</div>
	</div>
}

templ TrToggle(v V) {
	if v.Me != nil {
		<button class="link tr" data-on:click="@post('/toggle?k=tr')">
			if v.open("tr") {
				Hide translation
			} else {
				Show translation
			}
		</button>
	}
}

templ Tile(i int, c []Seg, cls, act string) {
	if act == "" {
		<div class={ "tile", cls } id={ fmt.Sprintf("c%d", i) } lang="ja">@Segs(c)</div>
	} else {
		<button class={ "tile", cls } id={ fmt.Sprintf("c%d", i) } lang="ja" data-on:click={ "@post('" + act + "')" }>@Segs(c)</button>
	}
}

templ PlayView(v V) {
	{{ r := v.R }}
	{{ ls := r.Lines[r.Turn] }}
	{{ lp := ls.Plan }}
	{{ ch := r.Plan.Characters[lp.Player] }}
	{{ pl := r.Players[lp.Player] }}
	{{ mine := v.MI == lp.Player }}
	if mine && r.Step == "scene" && ls.Status == "ready" {
		<i id={ fmt.Sprintf("alert-%d", r.Turn) } data-init="document.title='● Your turn';navigator.vibrate&&navigator.vibrate(200)"></i>
	} else {
		<i id="alert-off" data-init="document.title='Monogatari'"></i>
	}
	<div class="progress"><div class="bar" style={ widthStyle(r.progressPct()) }></div></div>
	<div class="roster top">
		for i, p := range r.Players {
			{{ ok, _ := r.score(i) }}
			<div class={ "person", templ.KV("active", i == lp.Player), templ.KV("off", !r.on(p)) } id={ fmt.Sprintf("s-%d", i) }>
				<span class={ "dot", "lv-" + p.Level }>{ r.Plan.Characters[i].Emoji }</span>
				<b>{ p.Name }</b>
				<span class="pts">{ strconv.Itoa(ok) }</span>
			</div>
		}
	</div>
	if r.Turn > 0 {
		<div class="history">
			for i := max(0, r.Turn-2); i < r.Turn; i++ {
				if d := r.Lines[i].Data; d != nil && r.Lines[i].Status == "ready" {
					<div class="past" id={ fmt.Sprintf("h-%d", i) }>
						<span>{ r.Plan.Characters[r.Lines[i].Plan.Player].Emoji }</span>
						<div class="jp" lang="ja">@Sentence(d)</div>
					</div>
				}
			}
		</div>
	}
	<section class="stage" id={ fmt.Sprintf("stage-%d", r.Turn) }>
		<div class="who">
			<div class="avatar bob">{ ch.Emoji }</div>
			<div>
				<b lang="ja">{ ch.Name }</b> @Badge(pl)
				<div class="muted">
					if mine {
						Your turn
					} else {
						{ pl.Name + " is playing" }
					}
				</div>
			</div>
		</div>
		<div class="textbox">
			if ls.Status != "ready" {
				<p class="narr">Writing this line<span class="dots"></span></p>
			} else if r.Step == "scene" || r.Step == "reorder" {
				<p class="narr">{ lp.Beat }</p>
				if r.Step == "reorder" {
					<p class="cue">“{ ls.Data.English }”</p>
				}
			} else {
				<p class="jp big-jp" lang="ja">@Sentence(ls.Data)</p>
				if v.open("tr") {
					<p class="cue">{ ls.Data.English }</p>
				}
				@TrToggle(v)
			}
		</div>
	</section>
	if ls.Status == "ready" {
		<section class="panel">
			@Panel(v, mine)
		</section>
	}
	if v.isHost() && !mine {
		<button class="link" data-on:click="@post('/skip')">Skip this turn</button>
	}
}

templ Panel(v V, mine bool) {
	{{ r := v.R }}
	{{ ls := r.Lines[r.Turn] }}
	{{ d := ls.Data }}
	{{ pl := r.Players[ls.Plan.Player] }}
	if r.Step == "scene" {
		if mine {
			<button class="btn green" data-on:click="@post('/begin')">Start</button>
		} else {
			<p class="muted center">{ pl.Name + " is getting ready…" }</p>
		}
	} else if r.Step == "reorder" {
		<div class="slots">
			if len(r.Placed) == 0 {
				<span class="placeholder">Tap the words in order</span>
			}
			for _, c := range r.Placed {
				if mine {
					@Tile(c, d.Chunks[c], tileCls(r.Wrong[c]), fmt.Sprintf("/unplace?c=%d", c))
				} else {
					@Tile(c, d.Chunks[c], tileCls(r.Wrong[c]), "")
				}
			}
		</div>
		<div class="bank">
			for _, c := range r.Shuf {
				if containsInt(r.Placed, c) {
					<div class="ghost-tile" id={ fmt.Sprintf("g%d", c) }></div>
				} else if mine {
					@Tile(c, d.Chunks[c], "", fmt.Sprintf("/place?c=%d", c))
				} else {
					@Tile(c, d.Chunks[c], "", "")
				}
			}
		</div>
		if len(r.Wrong) > 0 {
			<p class="err center" role="status">Not quite. Check the red words.</p>
		}
		if mine {
			<button class="btn green" disabled?={ len(r.Placed) != len(d.Chunks) } data-on:click="@post('/confirm')">Check</button>
		}
	} else if r.Step == "reading" {
		if mine {
			<div class="say">🎤 Read it aloud</div>
			<button class="btn green" data-on:click="@post('/readdone')">Done</button>
		} else {
			<div class="say">{ "🎧 " + pl.Name + " is reading" }</div>
		}
	} else {
		<h3 class="q">{ d.Quiz.Question }</h3>
		<div class="opts">
			for i, o := range d.Quiz.Options {
				if r.Step == "quiz" && mine {
					<button class="opt" id={ fmt.Sprintf("o%d", i) } data-on:click={ fmt.Sprintf("@post('/answer?o=%d')", i) }><span class="key">{ strconv.Itoa(i + 1) }</span>{ o }</button>
				} else {
					<div class={ "opt", optCls(r.Step, i, d.Quiz.Answer, r.Pick) } id={ fmt.Sprintf("o%d", i) }><span class="key">{ strconv.Itoa(i + 1) }</span>{ o }</div>
				}
			}
		</div>
		if r.Step == "result" {
			@ResultSheet(v, mine)
		}
	}
}

templ ResultSheet(v V, mine bool) {
	{{ r := v.R }}
	{{ d := r.Lines[r.Turn].Data }}
	{{ good := r.Pick == d.Quiz.Answer }}
	{{ pl := r.Players[r.Lines[r.Turn].Plan.Player] }}
	<div class={ "sheet", templ.KV("good", good || r.Auto), templ.KV("bad", !good && !r.Auto) } id={ fmt.Sprintf("sheet-%d", r.Turn) } role="status" data-init="setTimeout(()=>window.scrollTo({top:document.body.scrollHeight,behavior:'smooth'}),50)">
		<div class="sheet-in">
			<div class="sheet-msg">
				<div class="sheet-ic">
					if good || r.Auto {
						✓
					} else {
						✗
					}
				</div>
				<div>
					<b>
						if r.Auto {
							{ pl.Name + " was away. Played for them" }
						} else if good {
							Nice!
						} else {
							The correct answer is highlighted
						}
					</b>
					<p>{ d.Quiz.Explanation }</p>
				</div>
			</div>
			if mine {
				<button class={ "btn", templ.KV("green", good), templ.KV("red", !good) } data-on:click="@post('/next')">Continue</button>
			}
		</div>
	</div>
}

templ FinishedView(v V) {
	{{ r := v.R }}
	<div class="confetti" aria-hidden="true">
		for i := 0; i < 36; i++ {
			<i style={ confettiStyle(i) }></i>
		}
	</div>
	<div class="card pop center">
		<div class="big bob">🎉</div>
		<h1 lang="ja">@Notation(r.Plan.Scenario.Title)</h1>
		<div class="roster">
			for i, p := range r.Players {
				{{ ok, n := r.score(i) }}
				<div class="person">
					<span class={ "dot", "lv-" + p.Level }>{ r.Plan.Characters[i].Emoji }</span>
					<b>{ p.Name }</b>
					@Badge(p)
					<span class="pts">{ fmt.Sprintf("%d/%d", ok, n) }</span>
					if a := r.autoCount(i); a > 0 {
						<span class="muted">{ fmt.Sprintf("+%d auto", a) }</span>
					}
				</div>
			}
		</div>
	</div>
	<div class="card">
		<div class="row between"><h3>Story</h3>@TrToggle(v)</div>
		for i, l := range r.Lines {
			if l.Status == "ready" {
				<div class="past full">
					<span>{ r.Plan.Characters[l.Plan.Player].Emoji }</span>
					<div>
						<div class="jp" lang="ja">@Sentence(l.Data)</div>
						if v.open("tr") {
							<div class="muted">{ l.Data.English }</div>
						}
					</div>
					if r.turnMissed(i) {
						<span class="missed" title="Quiz missed">✗</span>
					}
				</div>
			}
		}
	</div>
	<div class="card">
		<h3>Words</h3>
		for i, b := range r.Plan.Briefings {
			<div class="vocab">
				<div class="row"><div class="avatar sm">{ r.Plan.Characters[i].Emoji }</div><b>{ r.Players[i].Name }</b></div>
				<div class="words">
					for _, wd := range b.Words {
						<div class="word" lang="ja"><ruby>{ wd.JP }<rt>{ wd.Reading }</rt></ruby><span lang="en">{ wd.EN }</span></div>
					}
				</div>
			</div>
		}
	</div>
	@LogBox(v)
	<div class="dock">
		<div class="dock-in">
			<button class="btn green" data-on:click="@post('/reset')">
				if v.Me != nil {
					Play again
				} else {
					Back to lobby
				}
			</button>
		</div>
	</div>
}
